# 이 파일은 커밋된다. 실제 값은 `.env.local` 에 두고 그 파일은 커밋하지 않는다.
#
# 배포 빌드에서 API 주소를 지정한다. 비워두면 `/api` 로 떨어지는데, 그건 dev 서버의
# 프록시 경로다 — 정적 배포본에는 프록시가 없으므로 운영 빌드에서는 반드시 지정해야 한다.
#   VITE_API_BASE_URL=https://api.mangro.cloud
VITE_API_BASE_URL=

# dev 서버 프록시가 바라볼 백엔드. 기본값은 로컬에서 띄운 백엔드다.
VITE_PROXY_TARGET=http://localhost:8080

# /app (소비자 앱 테스트)의 `카카오로 시작하기` 버튼이 쓰는 키. 콘솔 > 앱 키 > **JavaScript 키**다.
#
# 백엔드의 KAKAO_CONSUMER_APP_ID · KAKAO_CONSUMER_REST_API_KEY 와는 **다른 키**다. 같은 카카오
# 앱에서 나오지만 쓰는 쪽이 갈린다 -- 앱 ID 와 REST API 키는 서버가(토큰 검증·인가코드 교환),
# JavaScript 키는 브라우저가(Kakao.init) 쓴다. 서버 쪽만 채우면 이 버튼은 계속 비활성이다.
# (KAKAO_LOCAL_REST_API_KEY 는 또 별개다 -- 가게 등록의 주소 → 좌표 변환용이라 로그인과 무관하다.)
#
# 비어 있으면 버튼이 안내 문구를 내고, 나머지 로그인 수단(비회원 둘러보기 · 테스트 계정)은 그대로 쓴다.
#
# 해당 카카오 앱에 아래 둘이 등록돼 있어야 한다:
#   플랫폼 > Web > 사이트 도메인      http://localhost:5173
#   카카오 로그인 > Redirect URI      http://localhost:5173/app
#
# 값을 채운 뒤에는 **dev 서버를 다시 띄워야 한다** -- import.meta.env 는 빌드 타임에 박혀서
# HMR 로는 바뀌지 않는다.
VITE_KAKAO_CONSUMER_JS_KEY=

# /owner (점주 앱 테스트)의 `카카오로 시작하기` 버튼이 쓰는 키. **소비자 앱과 다른 카카오 앱**의
# JavaScript 키다 -- 서버가 access_token_info 로 app_id 를 확인하므로 소비자 키로 받은 토큰은
# 점주 엔드포인트에서 거부된다.
#
# 해당 카카오 앱에 아래 둘이 등록돼 있어야 한다:
#   플랫폼 > Web > 사이트 도메인      http://localhost:5173
#   카카오 로그인 > Redirect URI      http://localhost:5173/owner
#
# 비어 있으면 버튼이 안내 문구를 내고, 테스트 점주 계정 버튼은 그대로 쓴다.
VITE_KAKAO_OWNER_JS_KEY=
