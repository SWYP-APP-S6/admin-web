# 이 파일은 커밋된다. 실제 값은 `.env.local` 에 두고 그 파일은 커밋하지 않는다.
#
# 배포 빌드에서 API 주소를 지정한다. 비워두면 `/api` 로 떨어지는데, 그건 dev 서버의
# 프록시 경로다 — 정적 배포본에는 프록시가 없으므로 운영 빌드에서는 반드시 지정해야 한다.
#   VITE_API_BASE_URL=https://api.mangro.cloud
VITE_API_BASE_URL=

# dev 서버 프록시가 바라볼 백엔드. 기본값은 로컬에서 띄운 백엔드다.
VITE_PROXY_TARGET=http://localhost:8080

# /kakao-test (카카오 로그인 테스트 페이지)용 JS 키. 콘솔 > 앱 키 > JavaScript 키(REST API 키
# 아님). 소비자/점주 앱이 별개라 값도 둘이다. 비어 있으면 해당 역할의 로그인 버튼이 비활성화된다.
# 해당 카카오 앱의 플랫폼(Web) 도메인과 카카오 로그인 Redirect URI 에 이 dev 서버 주소
# (기본 http://localhost:5173, /kakao-test 경로 포함)가 등록되어 있어야 한다.
VITE_KAKAO_CONSUMER_JS_KEY=
VITE_KAKAO_OWNER_JS_KEY=
